# Site-specific settings (copy config/config.local.php.example)
config/config.local.php

# Runtime data: users and password hashes, requests, audit logs, SSL keys,
# generated web server configs. Only the deny rule and templates are committed.
data/*
!data/.htaccess
!data/*.example.json

# Generated EDL files
edl-files/*.txt

# Logs
*.log
logs/

# System files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
cache/

# Web server specific (site-level .htaccess only; data/.htaccess is committed)
/.htaccess
*.htpasswd

# SSL certificates
*.pem
*.crt
*.key
*.csr

# Backups
backups/
*.backup
*.bak

# Dependencies (if added later)
vendor/
node_modules/
